# Public configuration only. Copy to .local/production.env; keep secrets separate.
# These values are for isolated local verification with init-local-tls.sh.
CHESSLENS_PUBLIC_HOST=localhost
CHESSLENS_PUBLIC_AUTHORITY=localhost:8443
CHESSLENS_BIND_ADDRESS=127.0.0.1
CHESSLENS_HTTP_PORT=8080
CHESSLENS_HTTPS_PORT=8443
CHESSLENS_TLS_DIR=.local/local-tls
CHESSLENS_SECRETS_DIR=.local/production-secrets
CHESSLENS_SUBNET=172.30.14.0/24
CHESSLENS_PROXY_IP=172.30.14.10
